# AWS Configuration
# Copy this file to .env and fill in your credentials
# See README.md for instructions on getting AWS credentials

# Required: AWS credentials with Bedrock access
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Optional: Only needed when using temporary credentials (SSO, assume-role)
# AWS_SESSION_TOKEN=your_session_token_here

# Bedrock model to use (must be enabled in your AWS account)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Chatbot server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3002

# Backend API configuration
BACKEND_BASE_URL=http://localhost:3001
BACKEND_TIMEOUT=10

# Session configuration
SESSION_TTL_MINUTES=30
MAX_CONTEXT_MESSAGES=20

# LLM generation parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
